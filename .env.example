# Copy this file to ".env" and fill in your own values.
# The real .env is ignored by git. Never commit it.

# --- Database ---
# Local Postgres started with `docker compose up -d`. For a hosted database,
# paste its connection string here instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr_sentinel

# --- GitHub App ---
GITHUB_APP_ID=your_github_app_id
GITHUB_WEBHOOK_SECRET=the_secret_you_set_on_the_github_app

# Give the App's private key ONE of these two ways:
# 1) a path to the downloaded .pem file
GITHUB_PRIVATE_KEY_PATH=path/to/your-app.private-key.pem
# 2) the key itself (useful on hosts like Render). Leave the path above unset if you use this.
# GITHUB_PRIVATE_KEY_PEM=

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key
# Optional. minimal (default) | low | medium | high | default
# LLM_THINKING_LEVEL=minimal

# --- Dashboard ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=generate_a_long_random_token
